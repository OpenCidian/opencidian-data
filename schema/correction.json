{
  "$id": "https://github.com/OpenCidian/opencidian-data/schema/correction.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "char": {
              "type": "string",
              "pattern": "^\\p{Script=Han}$"
            }
          },
          "required": [
            "char"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "entry": {
              "type": "string"
            }
          },
          "required": [
            "entry"
          ],
          "additionalProperties": false
        }
      ]
    },
    "field": {
      "type": "string",
      "pattern": "^(hanviet\\.readings|hanviet\\.\\d+\\.readings|vi\\.senses|en\\.senses)$"
    },
    "set": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "add": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remove": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "by": {
      "type": "string",
      "minLength": 1
    },
    "issue": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": [
    "target",
    "field",
    "reason",
    "evidence",
    "by",
    "date"
  ],
  "additionalProperties": false
}
