{
  "$id": "https://github.com/OpenCidian/opencidian-data/schema/meta.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "OpenCidian"
    },
    "version": {
      "type": "string"
    },
    "builtAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "CC-BY-SA-4.0"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "attribution": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "url",
        "attribution"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "credit": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "sha256",
          "license",
          "url",
          "credit"
        ]
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "number"
        },
        "chars": {
          "type": "number"
        },
        "corrections": {
          "type": "number"
        }
      },
      "required": [
        "entries",
        "chars",
        "corrections"
      ]
    }
  },
  "required": [
    "name",
    "version",
    "builtAt",
    "commit",
    "license",
    "sources",
    "counts"
  ]
}
